{
  "name": "automation-control-room",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Automation Control Room: Phase 5 local runnable web/API/worker demonstration",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:contracts": "vitest run packages/contracts/test",
    "test": "npm run test:contracts",
    "contracts:jsonschema": "tsx packages/contracts/scripts/generate-json-schema.ts",
    "contracts:check": "tsx packages/contracts/scripts/generate-json-schema.ts --check",
    "typecheck:gate4d": "tsc --noEmit -p spikes/gate4d/tsconfig.json",
    "test:gate4d": "vitest run spikes/gate4d/test --maxWorkers=1",
    "typecheck:security": "tsc --noEmit -p packages/security/tsconfig.json",
    "test:security": "vitest run packages/security/test --maxWorkers=1",
    "typecheck:gate4e": "tsc --noEmit -p spikes/gate4e/tsconfig.json",
    "test:gate4e": "vitest run spikes/gate4e/test --maxWorkers=1",
    "typecheck:ux": "tsc --noEmit -p packages/ux-contracts/tsconfig.json",
    "test:ux": "vitest run packages/ux-contracts/test --maxWorkers=1",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "dev:web": "next dev apps/web --hostname 0.0.0.0 --port 3000",
    "build:web": "next build apps/web",
    "start:web": "next start apps/web --hostname 0.0.0.0 --port 3000",
    "typecheck:api": "tsc --noEmit -p apps/api/tsconfig.json",
    "typecheck:worker": "tsc --noEmit -p apps/worker/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "test:product": "node scripts/smoke-product.mjs",
    "test:history": "vitest run packages/runtime/test --maxWorkers=1",
    "test:canvas": "vitest run apps/web/test --maxWorkers=1",
    "test:browser": "node scripts/browser-slice2.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@xyflow/react": "12.12.1",
    "fastify": "5.12.7",
    "next": "16.4.5",
    "pg": "8.22.0",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
